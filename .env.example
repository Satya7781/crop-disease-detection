SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Use the Supabase, Railway, or local PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_crop

# Comma-separated browser origins. Do not include trailing slashes.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CSRF_TRUSTED_ORIGINS=

# Leave empty unless Google OAuth is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
